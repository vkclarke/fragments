TRUE  equ 1
FALSE equ 0
YES   equ TRUE
NO    equ FALSE

RTECODE  equ 0x4E73
RTSCODE  equ 0x4E75
JMPCODE  equ 0x4EF9
JMPWCODE equ 0x4EF8

CCRC equ 1<<0 ; carry
CCRV equ 1<<1 ; overflow
CCRZ equ 1<<2 ; zero
CCRN equ 1<<3 ; negative
CCRX equ 1<<4 ; extended

NTHF equ %0000100000000000
NTVF equ %0001000000000000

VDATA    equ 0xC00000
VDPDATA  equ VDATA
VCTRL    equ 0xC00004
VDPCTRL  equ VCTRL
Z80RAM   equ 0xA00000
Z80BUS   equ 0xA11100
Z80RESET equ 0xA11200
IODATA1  equ 0xA10003
IODATA2  equ 0xA10005
IODATA3  equ 0xA10007
IOCTRL1  equ 0xA10009
IOCTRL2  equ 0xA1000B
IOCTRL3  equ 0xA1000D

CRAMSZ    equ 2*64
VSRAMSZ   equ 80
HVRAMSZ   equ 4*240
SVRAMSZ   equ 8*80
OBJCOUNT  equ 64
OBJSZ     equ 64
SPRLAYERS equ 32
PROWSZ    equ 16*2
