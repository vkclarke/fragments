ChecksumCheck:
	lea     0x200.w,a0
	moveq   #0,d0
	move.l  0x1A4.w,d1 ; get ROM size from header
	sub.l   a0,d1
	lsr.l   #5,d1
	move.l  d1,d2
	swap    d2
	bra.s   @loop1     ; enter loop

@loop0:
	moveq   #-1,d1
@loop1:
	rept 32/2
		add.w   (a0)+,d0
	endr
	dbf     d1,@loop1
	dbf     d2,@loop0

	cmp.w   0x18E.w,d0 ; if our checksum doesn't match,
	bne.s   @fail      ; bail out
	rts

@fail:
	; do whatever here
	bra.s *
